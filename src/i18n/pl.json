  "privacy": {
    "title": "Polityka prywatności",
    "intro": "To prywatna aplikacja rodzinna, z której korzysta wyłącznie nasza rodzina. Nie jest usługą publiczną ani komercyjną.",
    "sections": {
      "data": {
        "title": "Jakie dane zbieramy",
        "text": "Imię i adres e-mail Twojego konta Google (logowanie) oraz to, co sam wpisujesz w aplikacji: listy zakupów, przepisy, plan obiadów i ustawienia. Dane przechowujemy w usłudze Supabase, a stronę udostępnia Cloudflare."
      },
      "calendar": {
        "title": "Kalendarz Google",
        "text": "Jeśli połączysz kalendarz, aplikacja czyta Twoje terminy na żywo z Google, tylko z kalendarzy wybranych przez Ciebie. Terminy nie są kopiowane do naszej bazy danych ani nigdzie zapisywane. Zapisujemy wyłącznie token odświeżający, zaszyfrowany, dzięki któremu aplikacja może czytać terminy bez ponownego logowania. Zgoda obejmuje także dodawanie wydarzeń; aplikacja robi to wyłącznie na Twoje polecenie. Termin oznaczony w Google jako prywatny jest ukryty przed innymi osobami z rodziny, a kalendarz ustawiony na „tylko ja” widzisz tylko Ty."
      },
      "receipts": {
        "title": "Zdjęcia paragonów",
        "text": "Zdjęcie paragonu jest wysyłane do API firmy Anthropic wyłącznie po to, aby odczytać pozycje. Nie zapisujemy go w bazie danych ani w plikach i nie umieszczamy go w logach."
      },
      "services": {
        "title": "Pogoda i święta",
        "text": "Pogodę pobieramy z Open-Meteo, a święta z Nager.Date. Wysyłamy tam tylko współrzędne miejsca (pogoda) albo kod kraju i rok (święta), bez imienia, e-maila i innych danych osobowych."
      },
      "sharing": {
        "title": "Brak sprzedaży i reklam",
        "text": "Nie sprzedajemy danych, nie przekazujemy ich reklamodawcom i nie wyświetlamy reklam."
      },
      "deletion": {
        "title": "Usuwanie danych",
        "text": "Przycisk „Odłącz” przy połączeniu z kalendarzem w Ustawieniach usuwa zapisany token i odwołuje dostęp w Google. Konto i dane rodziny usuwa administrator. Dostęp aplikacji do konta Google możesz też w każdej chwili cofnąć w ustawieniach swojego konta Google."
      },
      "google": {
        "title": "Dane z Google",
        "text": "Wykorzystanie informacji otrzymanych z API Google jest zgodne z Google API Services User Data Policy, w tym z wymogami Limited Use."
      }
    },
    "googlePolicyLink": "Google API Services User Data Policy",
    "contactTitle": "Kontakt",
    "contactText": "Pytania i prośby o usunięcie danych:",
    "back": "Wróć do aplikacji"
  },
